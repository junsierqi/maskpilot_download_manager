{
  "manifest_version": 3,
  "name": "MaskPilot 下载助手",
  "version": "0.3.0",
  "description": "将下载交给 MaskPilot，发现页面文件与媒体。自动接管默认关闭。",
  "minimum_chrome_version": "127",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "MaskPilot 下载助手",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "key": ""
}
