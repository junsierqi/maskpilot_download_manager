{
  "manifest_version": 3,
  "name": "MaskPilot 下载助手",
  "version": "0.2.0",
  "description": "将下载交给 MaskPilot，按需显示页面资源。自动接管和页面面板默认关闭。",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "downloads", "nativeMessaging", "cookies", "contextualIdentities"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {"scripts": ["background.js"], "type": "module"},
  "action": {"default_title": "MaskPilot 下载助手", "default_popup": "popup.html"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"},
  "browser_specific_settings": {"gecko": {"id": "downloads@maskpilot.invalid", "strict_min_version": "150.0", "data_collection_permissions": {"required": ["none"]}}}
}
