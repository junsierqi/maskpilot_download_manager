include_guard(GLOBAL)
set(_MASKPILOT_PORTABLE_SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/..")

# Keep the compiler probe, project and dependency builds on the same policy.
function(maskpilot_portable_options compile_out link_out)
  cmake_parse_arguments(PARSE_ARGV 2 ARG "" "SOURCE_ROOT" "")
  if(NOT ARG_SOURCE_ROOT)
    set(ARG_SOURCE_ROOT "${_MASKPILOT_PORTABLE_SOURCE_ROOT}")
  endif()
  cmake_path(ABSOLUTE_PATH ARG_SOURCE_ROOT NORMALIZE OUTPUT_VARIABLE source_root)
  cmake_path(GET source_root ROOT_PATH root_path)
  if(NOT source_root STREQUAL root_path)
    string(REGEX REPLACE "/+$" "" source_root "${source_root}")
  endif()
  file(TO_NATIVE_PATH "${source_root}" native_root)
  set(options /experimental:deterministic "/pathmap:${native_root}=.")
  if(NOT native_root STREQUAL source_root)
    list(APPEND options "/pathmap:${source_root}=.")
  endif()
  set(${compile_out} "${options}" PARENT_SCOPE)
  set(${link_out} "/PDBALTPATH:%_PDB%" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND DEFINED OUTPUT_FILE)
  if(DEFINED MASKPILOT_SOURCE_ROOT AND NOT MASKPILOT_SOURCE_ROOT STREQUAL "")
    maskpilot_portable_options(compile_flags link_flags SOURCE_ROOT "${MASKPILOT_SOURCE_ROOT}")
  else()
    maskpilot_portable_options(compile_flags link_flags)
  endif()
  set(result "{}")
  foreach(kind compile link)
    set(items "[]")
    set(index 0)
    foreach(flag IN LISTS ${kind}_flags)
      string(REPLACE "\\" "\\\\" escaped "${flag}")
      string(REPLACE "\"" "\\\"" escaped "${escaped}")
      string(JSON items SET "${items}" ${index} "\"${escaped}\"")
      math(EXPR index "${index} + 1")
    endforeach()
    string(JSON result SET "${result}" ${kind} "${items}")
  endforeach()
  file(WRITE "${OUTPUT_FILE}" "${result}\n")
endif()
