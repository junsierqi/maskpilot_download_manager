include("${CMAKE_CURRENT_LIST_DIR}/PortableFlags.cmake")

function(maskpilot_enable_portable_build target)
  if(NOT MSVC OR MASKPILOT_ENABLE_ASAN)
    return()
  endif()
  maskpilot_portable_options(compile_flags link_flags)
  foreach(flag IN LISTS compile_flags)
    target_compile_options(${target} INTERFACE "$<$<CONFIG:Release>:${flag}>")
  endforeach()
  foreach(flag IN LISTS link_flags)
    target_link_options(${target} INTERFACE "$<$<CONFIG:Release>:${flag}>")
  endforeach()
  if(CMAKE_BUILD_TYPE STREQUAL "Release")
    find_program(MASKPILOT_POWERSHELL powershell REQUIRED)
    execute_process(COMMAND "${MASKPILOT_POWERSHELL}" -NoProfile -ExecutionPolicy Bypass
      -File "${PROJECT_SOURCE_DIR}/scripts/probe_portable_compiler.ps1"
      RESULT_VARIABLE probe_result OUTPUT_VARIABLE probe_output ERROR_VARIABLE probe_error)
    if(NOT probe_result EQUAL 0)
      message(FATAL_ERROR "Portable compiler capability check failed:\n${probe_output}\n${probe_error}")
    endif()
    message(STATUS "Portable compiler capability check passed")
  endif()
endfunction()
